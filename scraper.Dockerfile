FROM node:22-slim
WORKDIR /usr/src/scraper/

# the lockfile was generated by pnpm 7
RUN corepack enable && corepack prepare pnpm@7.33.7 --activate

COPY ./package.json .
COPY ./pnpm-lock.yaml .
COPY ./pnpm-workspace.yaml .
COPY ./packages/scraper/package.json ./packages/scraper/
COPY ./packages/common/package.json ./packages/common/

RUN pnpm install --frozen-lockfile --filter @keimeno/wgra-scraper...

COPY . .

RUN pnpm --filter @keimeno/wgra-scraper... build

WORKDIR /usr/src/scraper/packages/scraper
CMD ["node", "dist/index.js"]
