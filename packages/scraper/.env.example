# reddit asks for a unique, descriptive user agent: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=node:wgra-scraper:0.1.0 (by /u/your-username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# only needed for the password grant, leave empty to read public listings
# with the client credentials alone (app-only OAuth)
REDDIT_USERNAME=
REDDIT_PASSWORD=
