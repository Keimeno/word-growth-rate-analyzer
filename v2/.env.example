# Reddit "script" app credentials. Only the client id and secret are needed, no reddit
# username or password: reading public listings works with app-only OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# reddit asks for a unique and descriptive user agent
REDDIT_USER_AGENT=python:wgra:2.0 (by /u/your-username)

# Secret key for hashing author names, so no usernames are stored. Generate it once with
# `openssl rand -hex 32` and never change it, or distinct-author counts stop matching up.
AUTHOR_HASH_KEY=

# Where the ingester and the CLI find ClickHouse. Inside docker compose the ingester
# uses the service name instead, see docker-compose.yml.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=3607
CLICKHOUSE_USER=wgra
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=wgra

GRAFANA_ADMIN_PASSWORD=
