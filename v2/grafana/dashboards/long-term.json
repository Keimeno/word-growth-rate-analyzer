  "panels": [
    {
      "type": "stat",
      "title": "Last run",
      "description": "When the latest stored results were found. The detector runs every day after 00:30 UTC; the results only change when a week has completed.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toUnixTimestamp(max(detected_at)) * 1000 FROM long_term_trends WHERE horizon = ${horizon:sqlstring}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Weeks analyzed up to",
      "description": "The last day of the last complete week analyzed (weeks run Monday to Sunday, UTC). The current week isn't complete yet and is left out.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH (SELECT max(week) FROM long_term_trends WHERE horizon = ${horizon:sqlstring}) AS latest SELECT formatDateTime(latest - 1, '%a %e %b %Y')",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Weeks of history",
      "description": "Complete weeks of data in the group's subreddits. A window runs once it has that many weeks: 13, 26 or 52. Until then there's nothing here.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT greatest(max(intDiv(toMonday(today()) - first_week, 7)), 0)\nFROM (\n    SELECT if(toDayOfWeek(min(hour)) = 1, toMonday(min(hour)), toMonday(min(hour)) + 7)\n           AS first_week\n    FROM scope_hourly\n    WHERE source = 'comment' AND subreddit IN (\n        SELECT subreddit FROM subreddit_groups WHERE group_name = ${group:sqlstring}\n    )\n    GROUP BY subreddit\n)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Trends",
      "description": "Stored trends in the selected scopes and window, at most 25 per scope and category.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH (SELECT max(week) FROM long_term_trends WHERE horizon = ${horizon:sqlstring}) AS latest\nSELECT countIf(category = 'emerging') AS emerging,\n       countIf(category = 'mainstreaming') AS mainstreaming,\n       countIf(category = 'fading') AS fading,\n       countIf(category = 'one-off') AS `one-off`\nFROM long_term_trends FINAL\nWHERE week = latest AND horizon = ${horizon:sqlstring} AND scope IN (${scope:singlequote}) AND kind IN (${kind:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "table",
      "title": "Emerging: rare at the start of the window, growing steadily",
      "description": "Terms mentioned by at most 1 in 1,000 comments and posts at the start of the window that grew significantly and steadily. per_month: growth per month (Theil–Sen slope of the log weekly share, robust to one-off spikes). q: Mann–Kendall p-value after Benjamini–Hochberg over every term the run tested, at most 0.05. start/end_per_1000: the trend line at the first and last week of the window. spike_share: how much of the change comes from the two highest weeks. peak: the highest week, times the median week. A group's share is the average of its subreddits' shares. Click a term to open it in the term explorer, weekly.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH (SELECT max(week) FROM long_term_trends WHERE horizon = ${horizon:sqlstring}) AS latest\nSELECT\n    concat(scope, ' · ', term) AS id,\n    scope,\n    term,\n    round(100 * (growth - 1), 1) AS per_month,\n    q_value AS q,\n    round(start_share, 3) AS start_per_1000,\n    round(end_share, 3) AS end_per_1000,\n    mentions,\n    round(spike_share, 2) AS spike_share,\n    round(peak, 1) AS peak,\n    kind,\n    concat('/d/wgra-terms?var-terms=', encodeURLFormComponent(term), if(startsWith(scope, 'r/'), concat('&var-group=tracked&var-subreddit=', encodeURLFormComponent(substring(scope, 3))), concat('&var-group=', encodeURLFormComponent(scope))), '&var-bucket=week&var-rate=macro&from=', toString(toUnixTimestamp(toDateTime(window_start, 'UTC')) * 1000), '&to=now') AS explore\nFROM long_term_trends FINAL\nWHERE week = latest AND horizon = ${horizon:sqlstring} AND scope IN (${scope:singlequote}) AND kind IN (${kind:singlequote}) AND category = 'emerging'\nORDER BY abs(log(growth)) DESC\nLIMIT 100",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "WITH (SELECT max(week) FROM long_term_trends WHERE horizon = ${horizon:sqlstring}) AS latest\nSELECT toDateTime(window_start, 'UTC') + toIntervalWeek(i - 1) AS time,\n       concat(scope, ' · ', term) AS id, weekly[i] AS per_1000\nFROM long_term_trends FINAL\nARRAY JOIN arrayEnumerate(weekly) AS i\nWHERE week = latest AND horizon = ${horizon:sqlstring} AND scope IN (${scope:singlequote}) AND kind IN (${kind:singlequote}) AND category = 'emerging'\nORDER BY time",
          "refId": "B"
        }
      ],
