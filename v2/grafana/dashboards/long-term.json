      {
        "type": "query",
        "name": "scope",
        "label": "Scopes",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT scope FROM (SELECT ${group:sqlstring} AS scope, 0 AS position UNION ALL SELECT concat('r/', subreddit), 1 FROM subreddit_groups WHERE group_name = ${group:sqlstring}) ORDER BY position, scope",
        "definition": "SELECT scope FROM (SELECT ${group:sqlstring} AS scope, 0 AS position UNION ALL SELECT concat('r/', subreddit), 1 FROM subreddit_groups WHERE group_name = ${group:sqlstring}) ORDER BY position, scope",
