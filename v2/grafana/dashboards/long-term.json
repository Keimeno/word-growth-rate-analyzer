{
  "uid": "wgra-long-term",
  "title": "Long-term trends",
  "description": "Terms growing or fading steadily over 13, 26 or 52 weeks, found once a day by wgra analyze.",
  "tags": [
    "wgra"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1h",
