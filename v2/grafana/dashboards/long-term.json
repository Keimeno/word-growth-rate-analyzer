  "templating": {
    "list": [
      {
        "type": "query",
        "name": "group",
        "label": "Group",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT group_name FROM subreddit_groups ORDER BY group_name = 'tracked' DESC, group_name",
        "definition": "SELECT DISTINCT group_name FROM subreddit_groups ORDER BY group_name = 'tracked' DESC, group_name",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "current": {
          "text": "tracked",
          "value": "tracked"
        }
