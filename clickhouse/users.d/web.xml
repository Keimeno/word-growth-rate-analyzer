<clickhouse>
    <!-- The web dashboard's own user (docs/WEB-DASHBOARD.md §5.5): it can only read, so a
         bug in the dashboard can't write, and its profile caps what it takes from the
         ingester and the analyzer on the shared machine. Its password comes from
         WEB_CLICKHOUSE_PASSWORD in .env. tests/test_web.py creates the same user with SQL
         from this file. -->
    <profiles>
        <wgra_web>
            <readonly>2</readonly>
            <max_threads>2</max_threads>
            <max_memory_usage>1000000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
            <max_concurrent_queries_for_user>6</max_concurrent_queries_for_user>
            <!-- higher is less important: the analyzer's queries win -->
            <priority>10</priority>
        </wgra_web>
    </profiles>
    <users>
        <wgra_web>
            <password from_env="WEB_CLICKHOUSE_PASSWORD"/>
            <profile>wgra_web</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <grants>
                <query>GRANT SELECT ON wgra.*</query>
                <!-- the Collection page: storage per table, the dashboard's own cost -->
                <query>GRANT SELECT ON system.parts</query>
                <query>GRANT SELECT ON system.query_log</query>
            </grants>
        </wgra_web>
    </users>
</clickhouse>
